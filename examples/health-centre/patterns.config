  zt1:
    usage: utility
    name: Sterilisation Room
    size:
      - 6.0
      - 1.0
    width:
      - 1.6
      - 0.4
    proportion:
      - 1.6
      - 0.4
    adjacency:
      - c
      - de1

  pt1:
    usage: bedroom
    name: Physiotherapy Room
    size:
      - 24.0
      - 4.0
    width:
      - 4.8
      - 0.8
    proportion:
      - 1.6
      - 0.5
    adjacency:
      - c

  qr1:
    usage: bedroom
    name: Counselling Room
    size:
      - 9.0
      - 1.5
    width:
      - 2.6
      - 0.5
    proportion:
      - 1.4
      - 0.4
    adjacency:
      - c

  tr1:
    usage: bedroom
    name: Treatment Room
    size:
      - 16.0
      - 2.5
    width:
      - 3.3
      - 0.6
    proportion:
      - 1.4
      - 0.4
    adjacency:
      - c

  # ---- ADMIN / STAFF ----
  mo1:
    usage: bedroom
    name: Manager's Office
    size:

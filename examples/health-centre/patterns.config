      - 0.4
    adjacency:
      - c
    # homemaker-py-1s3 (§26 path b): two similar-scale clinical procedure
    # rooms, flexible enough to double up in a small practice.
    co_locate:
      - de1

  de1:
    usage: bedroom
    name: Dental Surgery
    size:
      - 18.0
      - 3.0
    width:
      - 4.6
      - 0.7
    proportion:
      - 1.5
      - 0.4
    adjacency:
      - c
      - zt1
    co_locate:
